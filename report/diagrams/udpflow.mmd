flowchart TD
  r(["recvfrom(): chờ gói UDP, tối đa 255 byte"]) --> d1{"parking_update<br/>hợp lệ?"}
  d1 -- có --> p1["Cập nhật trạng thái bãi<br/>đánh thức màn hình<br/>còi: cháy hoặc ngập; chế độ cháy<br/>mỗi 5 phút lưu NVS"]
  d1 -- không --> d3{"climate<br/>hợp lệ?"}
  d3 -- có --> p3["Cập nhật nhiệt độ"]
  d3 -- không --> d2{"rfid_event<br/>hợp lệ?"}
  d2 -- không --> ig["Bỏ qua<br/>ghi cảnh báo"]
  d2 -- có --> ack["Trả rfid_ack cùng seq"]
  ack --> w2{"seq đã xử lý<br/>(16 gần nhất)?"}
  w2 -- "có: bản gửi lại" --> nx
  w2 -- chưa --> sc["rfid_session_scan()<br/>lưu NVS, đánh thức màn hình"]
  sc --> ok["ENTERED / EXITED<br/>mở cổng tương ứng 3 s<br/>(khi ra: hóa đơn 60 s)"]
  sc --> rej["INVALID_GATE / FULL / FLOOD<br/>không mở cổng<br/>thông báo 5 s"]
  p1 & p3 & ig & ok & rej --> nx(["Chờ gói tiếp theo"])
