flowchart TD
  r(["recvfrom(): chờ gói UDP, tối đa 255 byte"]) --> a1{"Chữ ký SipHash<br/>đúng khóa?"}
  a1 -- không --> ig["Bỏ qua<br/>ghi cảnh báo"]
  a1 -- có --> d1{"parking_update<br/>hợp lệ?"}
  d1 -- có --> w1{"seq mới?"}
  w1 -- có --> p1["Cập nhật trạng thái bãi<br/>đánh thức màn hình<br/>còi và chế độ cháy theo fire<br/>mỗi 5 phút lưu NVS"]
  d1 -- không --> d3{"climate<br/>hợp lệ?"}
  d3 -- có --> p3["Cập nhật nhiệt độ<br/>(nếu seq mới)"]
  d3 -- không --> d2{"rfid_event<br/>hợp lệ?"}
  d2 -- không --> ig
  d2 -- có --> w2{"seq trong cửa sổ<br/>chống phát lại?"}
  w2 -- "đã xử lý (gửi lại)" --> ack["Chỉ trả ACK"]
  w2 -- "quá cũ" --> ig
  w2 -- mới --> sc["Trả ACK, rfid_session_scan()<br/>lưu NVS, đánh thức màn hình"]
  sc --> ok["ENTERED / EXITED<br/>mở cổng tương ứng 3 s<br/>(khi ra: hóa đơn 60 s)"]
  sc --> rej["INVALID_GATE / FULL<br/>không mở cổng<br/>thông báo 5 s"]
  w1 -- "không: gói cũ" --> nx
  p1 & p3 & ig & ack & ok & rej --> nx(["Chờ gói tiếp theo"])
  classDef dec fill:#FFF3E0,stroke:#C77700;
  classDef bad fill:#FCE4EC,stroke:#AD1457;
  classDef good fill:#E8F5E9,stroke:#2E7D32;
  class a1,d1,d2,d3,w1,w2 dec; class rej,ig bad; class ok good;
