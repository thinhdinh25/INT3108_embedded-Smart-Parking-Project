# Build the app with -O2 (CONFIG_COMPILER_OPTIMIZATION_PERF) instead of the -Og debug default.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 1.5 MB app partition (2 MB flash); the default 1 MB one is almost full.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# 16 sockets: HTTP server (3 internal + 10 clients) + UDP receiver, with headroom.
CONFIG_LWIP_MAX_SOCKETS=16
# HTTPS to SePay next to a 115 KB framebuffer: allocate TLS buffers only while a request runs.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# RAM for the SePay TLS handshake (~30 KB) next to the 115 KB framebuffer and 37 KB GIF
# buffers: keep Wi-Fi and log code in flash (IRAM is carved out of the same DRAM) and cap
# Wi-Fi buffers. Throughput is irrelevant for a few small packets per second.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_LOG_IN_IRAM is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# my.sepay.vn sends GTS Root R4 cross-signed by GlobalSign Root CA, which the bundle lacks;
# without this the bundle checks only that missing root and the handshake fails (-0x3000).
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
